# ConvoBridge AI backend — example environment variables
# Copy to ".env" and fill in values. Export them in your shell before run_dev.py
# (this project reads os.environ; it does not auto-load .env by itself).

# Compute: cpu | cuda
DEVICE=cpu

# Whisper STT
# STT_MODEL_PATH=D:/Current_Projects/AI-Conference-Backend/models/faster-whisper-base
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1
STT_VAD_FILTER=true
STT_CONDITION_ON_PREVIOUS_TEXT=false

# Opus-MT translation
TRANSLATION_MAX_LENGTH=512
TRANSLATION_NUM_BEAMS=4
# Keep false — INT8 harms translation quality on CPU
OPUS_CPU_DYNAMIC_INT8=false

# Backend XTTS (optional; Flutter uses on-device TTS by default)
ENABLE_BACKEND_TTS=false

# Hugging Face (required for Gemma summary/chatbot base model)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemma quality knobs — keep INT8 off on CPU
GEMMA_LOAD_IN_4BIT=true
GEMMA_CPU_DYNAMIC_INT8=false

# Optional path overrides
# MODEL_CACHE_DIR=D:/Current_Projects/AI-Conference-Backend/models/cache
# SUMMARIZATION_ADAPTER_PATH=D:/Current_Projects/AI-Conference-Backend/summarization/models/gemma3-meeting-lora
# CHATBOT_ADAPTER_PATH=D:/Current_Projects/AI-Conference-Backend/chatbot/models/gemma3-chatbot-lora
